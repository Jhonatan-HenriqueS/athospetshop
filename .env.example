# Real public HTTPS origin, without a path. Keep empty until the domain is known.
SITE_URL=
# Opt in only after publication checks. Previews stay noindex by default.
SITE_INDEXABLE=false
# Public browser key: restrict to authorized domains and the Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Optional, only when verified. Otherwise use the name and full address query.
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_ID=
